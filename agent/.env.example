# Configuration du service — AUCUNE valeur reelle ici.
#
# Sur Altare, les Startup Settings se sont reveles impossibles a modifier de
# facon fiable : la configuration privee vit dans /home/container/.env, lu par
# index.js au demarrage (process.loadEnvFile). Permissions attendues : 0600.
#
# Ce fichier est le SEUL .env suivi par Git. Tous les autres sont ignores
# (voir .gitignore : *.env et .env.* sauf .env.example).

# Repertoire PERSISTANT (volume). Jamais un FS ephemere : la session WhatsApp
# et la deduplication doivent survivre a un redemarrage du conteneur.
DONNEES_DIR=/home/container/donnees

# Port du point de sante (ecoute sur 0.0.0.0).
# Altare injecte le port alloue dans SERVER_PORT, qui est prefere a PORT.
PORT=8080

# --- Backend scolaire ------------------------------------------------------
# NE PAS renseigner tant que l'API agent n'est pas reellement deployee et
# joignable : `backend:true` dans /sante n'est qu'un test de presence, donc
# une URL qui repond 404 produirait un faux vert.
# Verification attendue avant de renseigner : l'URL repond 401 (route presente,
# jeton exige) — et non 404 (route absente) ni 503 (jeton absent cote Vercel).
SCHOOL_API_BASE_URL=
AGENT_SERVICE_TOKEN=

# --- Fournisseurs IA -------------------------------------------------------
# ATTENTION : Groq (api.groq.com) et Grok de xAI (api.x.ai) sont deux services
# DIFFERENTS qui ne diffèrent que d'une lettre. Ne jamais recopier la meme
# valeur dans les deux : le service refuse la configuration et l'ecrit dans
# les journaux au demarrage.
#
# Groq      : LLM + transcription Whisper. Seul fournisseur de transcription.
# xAI       : LLM uniquement ici. Sa reconnaissance vocale vit sur POST /v1/stt,
#             de forme differente, et n'est pas branchee.
# OpenRouter: LLM uniquement (aucun point de transcription documente).
# Mistral   : LLM uniquement.
GROQ_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# Alias de compatibilite pour XAI_API_KEY, si cette variable a deja ete posee.
# GROK_API_KEY=

# --- Modeles (facultatif) --------------------------------------------------
# Les valeurs par defaut ont ete retenues apres interrogation de GET /models
# avec les comptes reels. A ne surcharger que pour un modele verifie present.
# GROQ_MODEL=openai/gpt-oss-120b
# XAI_MODEL=grok-4.3
# OPENROUTER_MODEL=openai/gpt-oss-120b
# MISTRAL_MODEL=mistral-small-latest

# --- Ordre et desactivation (facultatif) -----------------------------------
# Ordre d'essai ; les fournisseurs non cites passent apres, dans l'ordre par
# defaut (groq > xai > openrouter > mistral).
# IA_ORDRE=groq,openrouter,mistral,xai
# Exclut un fournisseur sans effacer sa cle (reversible sans la ressaisir).
# IA_DESACTIVES=

# --- Divers ----------------------------------------------------------------
# Chromium fourni par l'image ; a renseigner si le binaire n'est pas detecte.
# PUPPETEER_EXECUTABLE_PATH=

# Mettre a true UNIQUEMENT derriere un proxy de confiance : sinon
# X-Forwarded-For est falsifiable et la limitation par adresse devient inutile.
# TRUST_PROXY=false

# --- Mémoire conversationnelle Neon -----------------------------------------
# Désactivée par défaut. Activer après configuration des secrets sur Altare.
AGENT_MEMORY_ENABLED=false
AGENT_MEMORY_DATABASE_URL=
# Deux secrets indépendants de 32 octets : base64 ou 64 caractères hex.
# Génération : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AGENT_MEMORY_ENCRYPTION_KEY=
AGENT_MEMORY_HMAC_KEY=
