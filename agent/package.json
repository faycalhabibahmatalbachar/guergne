{
  "name": "school-ai-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent de pilotage de la plateforme guergne par WhatsApp (coeur indépendant du transport).",
  "scripts": {
    "start": "node index.js",
    "test": "node --test \"test/**/*.test.js\"",
    "sante": "curl -s localhost:8080/sante",
    "agent:evaluate": "node banc/lancer.mjs --etiquette campagne",
    "agent:evaluate:reprendre": "node banc/lancer.mjs --etiquette campagne --reprendre",
    "agent:parler": "node banc/parler.mjs",
    "agent:memoire": "node banc/memoire-durable.mjs",
    "agent:catalogue": "node banc/catalogue.mjs",
    "postinstall": "node scripts/rustine-wwebjs.mjs",
    "verifier-rustines": "node scripts/rustine-wwebjs.mjs --verifier"
  },
  "devDependencies": {
    "ssh2-sftp-client": "^12.1.1"
  },
  "main": "index.js",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "pg": "^8.23.1",
    "whatsapp-web.js": "1.34.7"
  },
  "optionalDependencies": {
    "exceljs": "^4.4.0"
  }
}
