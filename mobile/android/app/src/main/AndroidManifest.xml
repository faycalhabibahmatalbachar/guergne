<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        INTERNET n'est déclarée par Flutter que dans les manifestes de débogage
        et de profilage. Sans cette ligne, l'APK de production se lance, affiche
        l'écran d'activation, puis échoue à joindre le serveur sans dire
        pourquoi — c'est l'une des erreurs les plus coûteuses à diagnostiquer
        parce que tout fonctionne en développement.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!--
        Permet d'afficher « pas de connexion » plutôt qu'un délai d'attente de
        quarante secondes quand le téléphone est hors réseau.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!--
        Depuis Android 13, une application ne peut plus afficher de notification
        sans cette permission, demandée à l'exécution. Le greffon
        `firebase_messaging` la déclare aussi de son côté ; on la répète ici
        parce qu'une permission qui n'apparaît que dans le manifeste fusionné
        d'une dépendance est invisible à la relecture — et c'est celle dont
        dépend toute la fonction d'alerte aux parents.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <application
        android:label="LGR Parents"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!--
            Apparence des notifications.

            Sans `default_notification_icon`, Android prend l'icône de
            l'application, la réduit à sa silhouette et affiche un carré blanc
            plein dans la barre d'état : le défaut d'intégration le plus visible
            qui soit, et le plus fréquent.

            `default_notification_channel_id` sert de filet : si un message
            arrive sans canal — un envoi fait à la main, un outil tiers — il
            atterrit dans le canal de l'école plutôt que dans « Divers ».
            Le canal lui-même est créé au démarrage par `MainActivity`.
        -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/lgr_primaire" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="lgr_defaut" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
