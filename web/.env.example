# =============================================================================
# Lycée Guergné La Renaissance — variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs réelles.
# `.env.local` est ignoré par Git : aucun secret ne doit partir sur GitHub.
# =============================================================================

# --- Base de données Neon -----------------------------------------------------
# Connexion « pooler » : à utiliser par l'application (serverless = beaucoup de
# connexions courtes, le pooler évite d'épuiser la limite Postgres).
DATABASE_URL="postgresql://USER:MOTDEPASSE@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Connexion directe (sans pooler) : requise pour les MIGRATIONS uniquement.
# Le pooler en mode transaction ne supporte pas certaines instructions DDL.
DATABASE_URL_DIRECT="postgresql://USER:MOTDEPASSE@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Authentification ---------------------------------------------------------
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""
JWT_SECRET=""

# --- Application --------------------------------------------------------------
APP_URL="http://localhost:3000"
ETABLISSEMENT_NOM="Lycée Guergné La Renaissance"
ETABLISSEMENT_DEVISE="FCFA"

# --- Notifications push (Firebase Cloud Messaging) ----------------------------
# Optionnel tant que l'application mobile n'est pas déployée.
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# --- Passerelle SMS (repli pour les tuteurs sans smartphone) ------------------
#
# Trois modes, voir web/src/server/notifications/sms.ts :
#
#   journal    rien n'est envoyé, tout est tracé. Mode de développement.
#   generique  toute passerelle acceptant un POST JSON — dont 235SMS.
#   twilio     essai gratuit, mais n'envoie qu'aux numéros vérifiés un par un
#              et facture cher le Tchad. Inutilisable pour 737 tuteurs.
#
# En production l'école utilise 235SMS : les SMS partent d'une carte SIM
# tchadienne locale, ce qui coûte le prix d'un SMS national au lieu du tarif
# international d'un agrégateur étranger.
SMS_FOURNISSEUR="journal"

# 235SMS — l'URL se termine par /v1/messages, la clé commence par sk_live_
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="LGR"
